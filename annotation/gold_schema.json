{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CulinaryState gold recipe annotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_id",
    "annotator",
    "status",
    "ingredient_lines",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "gold-1.0"
    },
    "recipe_id": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "annotator": {
      "enum": [
        "Kush",
        "Parv",
        "ADJUDICATED"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "DONE",
        "ADJUDICATED"
      ]
    },
    "locale": {
      "type": "string"
    },
    "ingredient_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_index",
          "text",
          "spans",
          "entity",
          "concept"
        ],
        "properties": {
          "line_index": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end",
                "label",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "label": {
                  "enum": [
                    "FOOD",
                    "QUANTITY",
                    "UNIT",
                    "SIZE",
                    "FORM",
                    "STATE",
                    "ACTION",
                    "TOOL",
                    "MEDIUM",
                    "TIME",
                    "TEMPERATURE",
                    "ENDPOINT",
                    "INTERMEDIATE",
                    "OPTIONAL",
                    "ALTERNATIVE"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quantity_override": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_index",
          "text",
          "spans",
          "events"
        ],
        "properties": {
          "step_index": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end",
                "label",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "label": {
                  "enum": [
                    "FOOD",
                    "QUANTITY",
                    "UNIT",
                    "SIZE",
                    "FORM",
                    "STATE",
                    "ACTION",
                    "TOOL",
                    "MEDIUM",
                    "TIME",
                    "TEMPERATURE",
                    "ENDPOINT",
                    "INTERMEDIATE",
                    "OPTIONAL",
                    "ALTERNATIVE"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "Transform",
                    "Merge",
                    "Split",
                    "Reserve",
                    "Discard",
                    "Recombine",
                    "Transfer",
                    "Observe"
                  ]
                },
                "target": {
                  "type": "string"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "output": {
                  "type": "string"
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "label",
                      "fraction"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "fraction": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^\\d+/\\d+$"
                          },
                          {
                            "const": "UNKNOWN"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                },
                "process": {
                  "type": "string"
                },
                "tool": {
                  "type": "string"
                },
                "medium": {
                  "type": "string"
                },
                "time": {
                  "type": "string"
                },
                "temperature": {
                  "type": "string"
                },
                "endpoint": {
                  "type": "string"
                },
                "portion": {
                  "type": "string"
                },
                "fraction": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d+/\\d+$"
                    },
                    {
                      "const": "UNKNOWN"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "location": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "sets": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "evidence_span": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "implicit": {
                  "type": "boolean"
                }
              }
            }
          },
          "coref": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mention",
                "start",
                "end",
                "entity"
              ],
              "properties": {
                "mention": {
                  "type": "string"
                },
                "start": {
                  "type": "integer"
                },
                "end": {
                  "type": "integer"
                },
                "entity": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "why"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
