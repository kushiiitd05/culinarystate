    "time_conversion": {
      "type": "object",
      "required": [
        "status",
        "value",
        "convention"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_CONVERTED",
            "CONVERTED_EXACT",
            "CONVERTED_BY_STATED_CONVENTION",
            "NOT_CONVERTIBLE",
            "UNKNOWN"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "convention": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "CONVERTED_EXACT",
                  "CONVERTED_BY_STATED_CONVENTION"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "NOT_CONVERTED",
                  "NOT_CONVERTIBLE",
                  "UNKNOWN"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "CONVERTED_BY_STATED_CONVENTION"
              }
            }
          },
          "then": {
            "required": [
              "convention"
            ],
            "properties": {
              "convention": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "NOT_CONVERTED",
                  "CONVERTED_EXACT",
                  "NOT_CONVERTIBLE",
                  "UNKNOWN"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "convention": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "Normalised seconds as a SEPARATE field with a conversion status; the raw time value, raw unit token and printed unit label are never rewritten. s / min / h / d / week convert exactly (CONVERTED_EXACT); month and year are calendar durations and are NEVER exact: they stay NOT_CONVERTED, or are converted only under a stated convention (CONVERTED_BY_STATED_CONVENTION, convention text mandatory, e.g. '1 month = 30 d'); unit OTHER / UNKNOWN is not converted. Seconds are never produced from an unknown unit and never defaulted to 0 (07H-R lesson: calendar conversion at ingest was a failure class)."
    },
