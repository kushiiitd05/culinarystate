            "h",
            "d",
            "week",
            "month",
            "year",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "clock": {
          "const": "PROCESS_TAU"
        }
      },
      "description": "One design / condition point: a temperature (value_obj, raw unit kept) and the raw process times at it (clock PROCESS_TAU, raw time unit as in KIN.time_base.unit)."
    }
