{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "culinarystate/GRAPH.schema.json",
  "title": "GRAPH- recipe/session event-state graph",
  "description": "schema_version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^GRAPH-\\d{6}$"
    },
    "record_type": {
      "const": "GRAPH"
    },
    "schema_version": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DEPRECATED",
        "SUPERSEDED",
        "RETRACTED"
      ]
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^GRAPH-\\d{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "method",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "MANUAL",
            "IMPORT",
            "RULE",
            "LLM",
            "MODEL",
            "DERIVED",
            "SCRAPE"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC-\\d{6}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SNAP-\\d{6}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UNVERIFIED",
            "AI_PRECHECKED",
            "HUMAN_VERIFIED",
            "HUMAN_REJECTED",
            "NEEDS_SOURCE",
            "CONFLICT"
          ]
        },
        "verifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "ai_reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "external_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^REC-\\d{6}$"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "src",
          "dst",
          "relation"
        ],
        "additionalProperties": false,
        "properties": {
          "src": {
            "type": "string",
            "minLength": 1
          },
          "dst": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "TRANSFORMS_INTO",
              "MERGES_INTO",
              "SPLITS_INTO",
              "RESERVED_AS",
              "DISCARDED_FROM",
              "RECOMBINED_WITH",
              "TRANSFERRED_TO",
              "PART_OF",
              "LOCATED_IN",
              "OBSERVED_AS"
            ]
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^EVT-\\d{6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "alloc_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^ALLOC-\\d{6}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-\\d{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "replay_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "record_type",
    "version",
    "status",
    "created_at",
    "created_by",
    "provenance",
    "verification",
    "recipe_id",
    "edges"
  ]
}
