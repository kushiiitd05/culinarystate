{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "culinarystate/PROC.schema.json",
  "title": "PROC- canonical process / action family",
  "description": "schema_version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PROC-\\d{6}$"
    },
    "record_type": {
      "const": "PROC"
    },
    "schema_version": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DEPRECATED",
        "SUPERSEDED",
        "RETRACTED"
      ]
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^PROC-\\d{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "method",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "MANUAL",
            "IMPORT",
            "RULE",
            "LLM",
            "MODEL",
            "DERIVED",
            "SCRAPE"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC-\\d{6}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SNAP-\\d{6}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UNVERIFIED",
            "AI_PRECHECKED",
            "HUMAN_VERIFIED",
            "HUMAN_REJECTED",
            "NEEDS_SOURCE",
            "CONFLICT"
          ]
        },
        "verifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "ai_reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "external_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "ACTION",
        "ENDPOINT",
        "STATE_DESCRIPTOR",
        "COMPOSITE"
      ]
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^PROC-\\d{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "media": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TOOL-\\d{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "prerequisite_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PROC-\\d{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "required_condition_axes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "duration",
          "temperature",
          "ph",
          "moisture",
          "water_activity",
          "pressure",
          "oxygen",
          "salt",
          "sugar",
          "fat",
          "particle_size",
          "geometry",
          "agitation",
          "power",
          "humidity",
          "heating_rate",
          "batch_size"
        ]
      },
      "uniqueItems": true
    },
    "likely_state_variable_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SVAR-\\d{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "mechanism_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "corpus_frequency": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_coverage": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "record_type",
    "version",
    "status",
    "created_at",
    "created_by",
    "provenance",
    "verification",
    "canonical_name",
    "family",
    "kind"
  ]
}
