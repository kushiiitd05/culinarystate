{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "culinarystate/INST.schema.json",
  "title": "INST- instruction semantic record",
  "description": "schema_version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^INST-\\d{6}$"
    },
    "record_type": {
      "const": "INST"
    },
    "schema_version": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DEPRECATED",
        "SUPERSEDED",
        "RETRACTED"
      ]
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^INST-\\d{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "method",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "MANUAL",
            "IMPORT",
            "RULE",
            "LLM",
            "MODEL",
            "DERIVED",
            "SCRAPE"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC-\\d{6}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SNAP-\\d{6}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UNVERIFIED",
            "AI_PRECHECKED",
            "HUMAN_VERIFIED",
            "HUMAN_REJECTED",
            "NEEDS_SOURCE",
            "CONFLICT"
          ]
        },
        "verifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "ai_reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "external_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^REC-\\d{6}$"
    },
    "step_index": {
      "type": "integer",
      "minimum": 0
    },
    "raw_text": {
      "type": "string",
      "minLength": 1
    },
    "normalized_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sentence_spans": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-\\d{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "record_type",
    "version",
    "status",
    "created_at",
    "created_by",
    "provenance",
    "verification",
    "recipe_id",
    "step_index",
    "raw_text"
  ]
}
