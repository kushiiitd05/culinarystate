{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "culinarystate/MODEL.schema.json",
  "title": "MODEL- trained / released model",
  "description": "schema_version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MODEL-\\d{6}$"
    },
    "record_type": {
      "const": "MODEL"
    },
    "schema_version": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DEPRECATED",
        "SUPERSEDED",
        "RETRACTED"
      ]
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^MODEL-\\d{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "method",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "MANUAL",
            "IMPORT",
            "RULE",
            "LLM",
            "MODEL",
            "DERIVED",
            "SCRAPE"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC-\\d{6}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SNAP-\\d{6}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UNVERIFIED",
            "AI_PRECHECKED",
            "HUMAN_VERIFIED",
            "HUMAN_REJECTED",
            "NEEDS_SOURCE",
            "CONFLICT"
          ]
        },
        "verifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "ai_reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "external_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "training_dataset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DATASET-\\d{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "split_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SPLIT-\\d{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "checkpoint_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "card_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_on": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "UNKNOWN"
      ]
    },
    "reproduction_status": {
      "type": "string",
      "enum": [
        "SOURCE_REPORTED",
        "REPRODUCED",
        "REPRODUCED_WITH_DEVIATION",
        "FAILED",
        "OURS"
      ]
    }
  },
  "required": [
    "id",
    "record_type",
    "version",
    "status",
    "created_at",
    "created_by",
    "provenance",
    "verification",
    "name",
    "family",
    "reproduction_status"
  ]
}
