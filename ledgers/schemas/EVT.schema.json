{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "culinarystate/EVT.schema.json",
  "title": "EVT- atomic recipe/session event",
  "description": "schema_version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EVT-\\d{6}$"
    },
    "record_type": {
      "const": "EVT"
    },
    "schema_version": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DEPRECATED",
        "SUPERSEDED",
        "RETRACTED"
      ]
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^EVT-\\d{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "method",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "MANUAL",
            "IMPORT",
            "RULE",
            "LLM",
            "MODEL",
            "DERIVED",
            "SCRAPE"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC-\\d{6}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SNAP-\\d{6}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UNVERIFIED",
            "AI_PRECHECKED",
            "HUMAN_VERIFIED",
            "HUMAN_REJECTED",
            "NEEDS_SOURCE",
            "CONFLICT"
          ]
        },
        "verifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "ai_reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "external_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^REC-\\d{6}$"
    },
    "step_index": {
      "type": "integer",
      "minimum": 0
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "process_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^PROC-\\d{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "action_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_state_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^STATE-\\d{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "output_state_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^STATE-\\d{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "tool_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TOOL-\\d{6}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "condition_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^COND-\\d{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "endpoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "optional": {
      "type": "boolean"
    },
    "trajectory": {
      "type": "string",
      "enum": [
        "PLANNED",
        "OBSERVED_SESSION",
        "PREDICTED"
      ]
    },
    "omitted_step_candidate": {
      "type": "boolean"
    },
    "span": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "record_type",
    "version",
    "status",
    "created_at",
    "created_by",
    "provenance",
    "verification",
    "recipe_id",
    "step_index",
    "ordinal",
    "trajectory"
  ]
}
